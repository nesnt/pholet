# ==============================================================================
# PHOLET - Environment Variables Template
# Salin file ini menjadi .env dan lengkapi dengan kredensial rahasia Anda.
# JANGAN PERNAH menyimpan atau mem-push nilai kredensial asli ke Git!
# ==============================================================================

# Database PostgreSQL / Supabase
# Branch 'main' menggunakan Supabase pooler, branch 'local' menggunakan PostgreSQL lokal
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Google Drive API (OAuth 2.0 untuk media storage serverless)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# Environment Mode
NODE_ENV="development"
